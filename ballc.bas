10 REM Bouncing ball - BASICA version of ../../CPM86/cpm86-hacking/ball.c (320x200, 4-color CGA)
20 SCREEN 1
30 COLOR 0,1
40 CLS
50 BX = 89: BY = 59: BW = 139: BH = 78: BT = 1
60 BALLW = 8: BALLH = 8
70 DIM BALL%(3,63)
80 FOR F = 0 TO 3
90 FOR I = 0 TO 63
100 READ BALL%(F,I)
110 NEXT I
120 NEXT F
130 X = BX+1: Y = BY+1: XINC = 1: YINC = 1: SEQ = 0
140 LINE (BX,BY)-(BX+BW,BY+BH),1,B
150 X = X + XINC
160 Y = Y + YINC
170 IF X > BX+BW-BALLW-BT THEN XINC = -1 : GOTO 190
180 IF X <= BX+BT THEN XINC = 1
190 IF Y > BY+BH-BALLH-BT THEN YINC = -1 : GOTO 210
200 IF Y <= BY+BT THEN YINC = 1
210 FRM = INT(SEQ/4)
220 OFS = 0
230 FOR YY = 0 TO BALLH-1
240 FOR XX = 0 TO BALLW-1
250 PSET (X+XX,Y+YY), BALL%(FRM,OFS)
260 OFS = OFS + 1
270 NEXT XX
280 NEXT YY
290 SEQ = SEQ + 1
300 IF SEQ > 12 THEN SEQ = 0
310 FOR D = 1 TO 25: NEXT D
320 A$ = INKEY$
330 IF A$ = "" THEN GOTO 150
340 SCREEN 0
350 CLS
360 SYSTEM
370 DATA 0,0,0,0,0,0,0,0
380 DATA 0,0,1,1,1,1,0,0
390 DATA 0,1,2,2,3,2,1,0
400 DATA 0,1,2,2,3,3,1,0
410 DATA 0,1,2,2,2,2,1,0
420 DATA 0,1,2,2,2,2,1,0
430 DATA 0,0,1,1,1,1,0,0
440 DATA 0,0,0,0,0,0,0,0
450 DATA 0,0,0,0,0,0,0,0
460 DATA 0,0,1,1,1,1,0,0
470 DATA 0,1,2,2,2,2,1,0
480 DATA 0,1,2,2,2,2,1,0
490 DATA 0,1,2,2,3,3,1,0
500 DATA 0,1,2,2,3,2,1,0
510 DATA 0,0,1,1,1,1,0,0
520 DATA 0,0,0,0,0,0,0,0
530 DATA 0,0,0,0,0,0,0,0
540 DATA 0,0,1,1,1,1,0,0
550 DATA 0,1,2,2,2,2,1,0
560 DATA 0,1,2,2,2,2,1,0
570 DATA 0,1,3,3,2,2,1,0
580 DATA 0,1,2,3,2,2,1,0
590 DATA 0,0,1,1,1,1,0,0
600 DATA 0,0,0,0,0,0,0,0
610 DATA 0,0,0,0,0,0,0,0
620 DATA 0,0,1,1,1,1,0,0
630 DATA 0,1,2,3,2,2,1,0
640 DATA 0,1,3,3,2,2,1,0
650 DATA 0,1,2,2,2,2,1,0
660 DATA 0,1,2,2,2,2,1,0
670 DATA 0,0,1,1,1,1,0,0
680 DATA 0,0,0,0,0,0,0,0
