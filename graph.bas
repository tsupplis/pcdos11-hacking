10 SCREEN 2
20 CLS
30 PI = 3.14159265#
40 CX = 320: CY = 100: AMP = 70: PERIOD = 160
50 LINE (0,CY)-(639,CY)
60 LINE (629,CY-5)-(639,CY)
70 LINE (629,CY+5)-(639,CY)
80 LINE (CX,199)-(CX,0)
90 LINE (CX-5,10)-(CX,0)
100 LINE (CX+5,10)-(CX,0)
110 FOR X = 0 TO 639
120 THETA = (X - CX) * 2 * PI / PERIOD
130 Y = CY - AMP * COS(THETA)
140 PSET (X,Y)
150 NEXT X
160 LOCATE 23,1
170 PRINT "f(x) = cosine(x)"
